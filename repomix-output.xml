<file path="Landing.css">
:root {
    --background: #f8fafc;
    --textdark: #0f172a;
    --textlight: #ffffff;
    --darkBlue: #232c57;
    --darkPurp: #4b3b8f;
    --primaryPurp: #6d59bd;
    --primaryBlue: #3b82f6;
    --secondaryBlue: #e2e8f8;
    --accentsPurple: #e0e7ff;
    --font-mono: 'JetBrains Mono', monospace;
}

html {
    scroll-padding-top: env(safe-area-inset-top, 0px);
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--textdark);
    background: var(--background);
    min-height: 100vh;
}


@property --x1 {
