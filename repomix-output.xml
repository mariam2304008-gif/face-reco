                            <p class="form-hint" id="prioHint"></p>
                            <button class="button button-primary submit-request" type="submit">Send to all students<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></button>
