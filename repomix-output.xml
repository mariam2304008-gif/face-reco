                    <div class="table-wrap"><table class="records-table"><thead><tr><th>DATE</th><th>COURSE</th><th>CHECK-IN</th><th>CHECK-OUT</th><th>STATUS</th><th aria-label="Actions"></th></tr></thead><tbody id="historyRows"></tbody></table></div>
                    <div class="empty-state" id="historyEmpty" hidden><span class="empty-icon">⌕</span><h3>No records found</h3><p>Try another search or clear your filters.</p><button class="button button-soft" type="button" id="emptyClearFilters">Clear filters</button></div>
                    <div class="table-footer"><span id="historyResultCount">Showing 8 of 20 sessions</span><span class="footer-note"><span class="tiny-dot green"></span>Attendance synced</span></div>
                </section>
                <p class="demo-note"><span>ⓘ</span> Demo data for presentation. Attendance updates and correction requests are not connected to a university system.</p>
            </div>
        </main>
    </div>
    <script src="CampusPages.js" defer></script>
</body>
