                        <button class="button button-soft" type="button" id="markAllRead">Mark all as read</button>
                    </div>
                    <ul class="plain-list" id="alertFeed"></ul>
                    <div class="empty-state" id="alertEmpty" hidden><span class="empty-icon">✓</span><h3>No alerts</h3><p>System and student activity will show up here.</p></div>
                </section>

                <section class="panel records-panel panel-gap" aria-labelledby="logHeading">
                    <div class="panel-heading">
                        <div><h2 id="logHeading">System event log</h2><p>Tablet syncs, recognition health and platform events</p></div>
                        <div class="log-actions">
                            <button class="button button-soft" type="button" id="liveToggle" aria-pressed="true"><span class="live-pulse"></span><span id="liveToggleText">Live feed on</span></button>
                            <button class="button button-danger" type="button" id="clearLogs">Clear log</button>
                        </div>
                    </div>
                    <div class="log-toolbar">
                        <div class="filter-tabs" role="group" aria-label="Filter events">
                            <button type="button" class="filter-tab active" data-log-filter="all" aria-pressed="true">All <span data-log-count="all">0</span></button>
                            <button type="button" class="filter-tab" data-log-filter="error" aria-pressed="false">Errors <span data-log-count="error">0</span></button>
                            <button type="button" class="filter-tab" data-log-filter="warn" aria-pressed="false">Warnings <span data-log-count="warn">0</span></button>
                            <button type="button" class="filter-tab" data-log-filter="success" aria-pressed="false">Success <span data-log-count="success">0</span></button>
                            <button type="button" class="filter-tab" data-log-filter="info" aria-pressed="false">Info <span data-log-count="info">0</span></button>
                        </div>
                        <label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg><input id="logSearch" type="search" placeholder="Search events or sources..." aria-label="Search events"></label>
                    </div>
                    <div class="table-wrap log-scroll" id="logWrap">
                        <table class="records-table log-table">
                            <thead><tr><th>TIME</th><th>LEVEL</th><th>EVENT</th><th>SOURCE</th></tr></thead>
                            <tbody id="logRows"></tbody>
                        </table>
                    </div>
                    <div class="empty-state" id="logEmpty" hidden><span class="empty-icon">⌕</span><h3>No events found</h3><p>Try another filter or clear your search.</p></div>
                    <div class="table-footer"><span id="logFooter">Showing 0 of 0 events</span><span class="footer-note"><span class="tiny-dot blue"></span>Live events are simulated in this demo</span></div>
                </section>

                <p class="demo-note"><span>ⓘ</span> Broadcasts are saved in this browser and appear in the student portal through localStorage. A real deployment needs a university backend to reach every student.</p>
            </div>
        </main>
    </div>

    <div class="admin-toast" id="adminToast" role="status" aria-live="polite"></div>

    <script src="AdminShared.js" defer></script>
    <script src="MangAlerts.js" defer></script>
</body>
</html>
