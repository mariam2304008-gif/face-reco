<file path="AdminCorr.js">
// CampusLens admin: correction requests with SLA tracking. Needs AdminShared.js loaded first.
// Reads and writes the same localStorage list the student portal uses ('campusLensDemoRequests').
(function () {
    'use strict';

    var A = window.CampusLensAdmin;
    if (!A) return;

    var esc = A.escapeHTML;
    var HOUR = 3600000;

    // The student portal does not store IDs yet, so the admin side looks them up by name.
    var STUDENT_IDS = {
        'Ahmed Mohamed': '20230417',
        'Sara Khaled': '20230562',
        'Omar Hassan': '20230188',
        'Mariam Adel': '20230731'
    };
    var STATE_LABELS = { ok: 'On Track', warning: 'Due Soon', breached: 'SLA Breached' };

    var activeFilter = 'all';
    var searchText = '';
    var openId = null;
    var toastTimer = null;

    function byId(id) { return document.getElementById(id); }

    function showToast(message) {
        var toast = byId('adminToast');
        toast.textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 4200);
    }

    function longDate(timestamp) {
        return new Date(timestamp).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function capitalize(text) {
        text = String(text || '');
        return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function studentIdOf(request) {
        if (request.studentId) return String(request.studentId);
        var name = A.studentOf(request);
        if (STUDENT_IDS[name]) return STUDENT_IDS[name];
        var sum = 0;
        for (var i = 0; i < name.length; i += 1) sum = (sum * 31 + name.charCodeAt(i)) % 10000;
        return '2023' + String(sum).padStart(4, '0');
    }

    function slaPill(state) {
        return '<span class="sla-pill ' + esc(state) + '">' + esc(STATE_LABELS[state]) + '</span>';
    }

    function slaNote(sla) {
        return sla.state === 'breached'
            ? 'Overdue by ' + A.formatDuration(sla.remaining)
            : 'Breaches in ' + A.formatDuration(sla.remaining);
    }

    function requestedBadge(status) {
        return '<span class="status-badge status-' + esc(String(status).toLowerCase()) + '">' + esc(status) + '</span>';
    }

    /* ---------- data ---------- */

    function buildRows(now) {
        var rows = A.getRequests().map(function (request) {
            var pending = request.status === 'pending';
            return {
                request: request,
                pending: pending,
                submitted: A.submittedAtOf(request),
                sla: pending ? A.slaInfo(request, now) : null
            };
        });
        rows.sort(function (a, b) {
            if (a.pending !== b.pending) return a.pending ? -1 : 1;
            if (a.pending) return a.sla.remaining - b.sla.remaining;   // closest to breach first
            return (b.request.resolvedAt || b.submitted) - (a.request.resolvedAt || a.submitted);
        });
        return rows;
    }

    function matchesFilter(row) {
        if (activeFilter === 'urgent') return row.pending && row.sla.state !== 'ok';
        if (activeFilter === 'pending') return row.pending;
        if (activeFilter === 'resolved') return !row.pending;
        return true;
    }

    function matchesSearch(row) {
        if (!searchText) return true;
        var haystack = (A.studentOf(row.request) + ' ' + studentIdOf(row.request) + ' ' + row.request.course).toLowerCase();
        return haystack.indexOf(searchText) !== -1;
    }

    /* ---------- rendering ---------- */

    function render() {
        var now = Date.now();
        var rows = buildRows(now);
        var pendingRows = rows.filter(function (row) { return row.pending; });
        var counts = { ok: 0, warning: 0, breached: 0 };
        pendingRows.forEach(function (row) { counts[row.sla.state] += 1; });

        byId('sumPending').textContent = String(pendingRows.length).padStart(2, '0');
        byId('sumOk').textContent = String(counts.ok).padStart(2, '0');
        byId('sumSoon').textContent = String(counts.warning).padStart(2, '0');
        byId('sumBreached').textContent = String(counts.breached).padStart(2, '0');
        byId('sumBreachedCard').classList.toggle('alert-card', counts.breached > 0);

        var tabCounts = {
            all: rows.length,
            urgent: counts.warning + counts.breached,
            pending: pendingRows.length,
            resolved: rows.length - pendingRows.length
        };
        document.querySelectorAll('[data-count]').forEach(function (element) {
            element.textContent = String(tabCounts[element.getAttribute('data-count')]);
        });
        document.querySelectorAll('[data-corr-filter]').forEach(function (tab) {
            var isActive = tab.getAttribute('data-corr-filter') === activeFilter;
            tab.classList.toggle('active', isActive);
            tab.setAttribute('aria-pressed', String(isActive));
        });

        var visible = rows.filter(function (row) { return matchesFilter(row) && matchesSearch(row); });

        byId('requestRows').innerHTML = visible.map(function (row) {
            var request = row.request;
            var name = A.studentOf(request);
            var statusName = capitalize(request.status);

            var slaCell;
            if (row.pending) {
                slaCell = slaPill(row.sla.state) + '<small class="cell-note">' + esc(slaNote(row.sla)) + '</small>';
            } else if (typeof request.resolvedAt === 'number') {
                var took = request.resolvedAt - row.submitted;
                var met = took <= A.SLA_HOURS * HOUR;
                slaCell = '<span class="sla-pill ' + (met ? 'ok' : 'breached') + '">' + (met ? 'Met SLA' : 'Missed SLA') + '</span>' +
                    '<small class="cell-note">Resolved in ' + esc(A.formatDuration(took)) + '</small>';
            } else {
                slaCell = '<small class="cell-note">Not tracked</small>';
            }

            return '<tr>' +
                '<td class="course-cell"><strong>' + esc(name) + '</strong><small>ID ' + esc(studentIdOf(request)) + '</small></td>' +
                '<td class="course-cell"><strong>' + esc(request.course) + '</strong><small>Class on ' + esc(A.formatShortDate(request.date)) + '</small></td>' +
                '<td>' + requestedBadge(request.requestedStatus) + '</td>' +
                '<td class="date-cell">' + esc(A.formatDateTime(row.submitted)) + '<small>' + esc(A.formatDuration(now - row.submitted)) + ' ago</small></td>' +
                '<td><span class="request-status ' + esc(request.status) + '">' + esc(statusName) + '</span></td>' +
                '<td>' + slaCell + '</td>' +
                '<td><button class="feed-btn" type="button" data-review="' + esc(request.id) + '">' + (row.pending ? 'Review' : 'View') + '</button></td>' +
                '</tr>';
        }).join('');

        byId('requestsEmpty').hidden = visible.length > 0;
        byId('requestsTableWrap').hidden = visible.length === 0;
        byId('requestsFooter').textContent = 'Showing ' + visible.length + ' of ' + rows.length + ' request' + (rows.length === 1 ? '' : 's');
        byId('liveSyncLabel').textContent = 'Live · updated ' + new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    /* ---------- review dialog ---------- */

    var dialog = byId('reviewDialog');
    var noteInput = byId('reviewNote');

    function clearNoteError() {
        noteInput.closest('.field-control').classList.remove('has-error');
        noteInput.closest('.field-control').querySelector('.field-error').textContent = '';
    }

    function findRow(id) {
        var rows = buildRows(Date.now());
        for (var i = 0; i < rows.length; i += 1) {
            if (String(rows[i].request.id) === String(id)) return rows[i];
        }
        return null;
    }

    function openReview(id) {
        var row = findRow(id);
        if (!row) return;
        var request = row.request;
        var name = A.studentOf(request);
        var now = Date.now();
        openId = String(request.id);

        byId('reviewKicker').textContent = row.pending ? 'REVIEW REQUEST' : 'REQUEST DETAILS';
        byId('reviewHeading').textContent = name;
        byId('reviewSub').textContent = request.course + ' · ' + A.formatShortDate(request.date);

        var requestedDot = { present: 'present-dot', late: 'late-dot', absent: 'absent-dot' }[String(request.requestedStatus).toLowerCase()] || 'present-dot';
        var items = [
            ['Student', esc(name)],
            ['Student ID', '<span class="mono">' + esc(studentIdOf(request)) + '</span>'],
            ['Course', esc(request.course)],
            ['Class date', esc(longDate(new Date(request.date + 'T12:00:00').getTime()))],
            ['Requested status', '<span class="choice-dot ' + requestedDot + '"></span>' + esc(request.requestedStatus)],
            ['Submitted', esc(A.formatDateTime(row.submitted))]
        ];
        byId('reviewDetails').innerHTML = items.map(function (item) {
            return '<div><dt>' + item[0] + '</dt><dd>' + item[1] + '</dd></div>';
        }).join('');
        byId('reviewReason').textContent = request.reason || 'No reason was provided.';

        var slaBox = byId('reviewSla');
        var outcomeBox = byId('reviewOutcome');
        var pending = row.pending;

        if (pending) {
            slaBox.innerHTML = slaPill(row.sla.state) +
                '<span class="review-sla-text">Submitted ' + esc(A.formatDuration(now - row.submitted)) + ' ago. ' + esc(slaNote(row.sla)) + '.</span>';
            slaBox.hidden = false;
            outcomeBox.hidden = true;
        } else {
            slaBox.hidden = true;
            var approved = request.status === 'approved';
            var by = request.resolvedBy ? ' by ' + esc(request.resolvedBy) : '';
            var when = typeof request.resolvedAt === 'number' ? ' on ' + esc(A.formatDateTime(request.resolvedAt)) : '';
            outcomeBox.className = 'outcome-box ' + request.status;
            outcomeBox.innerHTML = '<strong>' + (approved ? 'Approved' : 'Rejected') + by + when + '</strong>' +
                '<p>' + esc(request.reviewNote || request.detail || '') + '</p>';
            outcomeBox.hidden = false;
        }

        byId('noteField').hidden = !pending;
        byId('approveBtn').hidden = !pending;
        byId('rejectBtn').hidden = !pending;
        noteInput.value = '';
        byId('noteCount').textContent = '0';
        clearNoteError();

        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
    }

    function closeReview() {
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
    }

    dialog.addEventListener('close', function () {
        openId = null;
        noteInput.value = '';
        clearNoteError();
    });
    dialog.addEventListener('click', function (event) {
        if (event.target === dialog) closeReview();
    });
    document.querySelectorAll('[data-close-dialog]').forEach(function (button) {
        button.addEventListener('click', closeReview);
    });
    noteInput.addEventListener('input', function () {
        byId('noteCount').textContent = String(noteInput.value.length);
        clearNoteError();
    });

    /* ---------- approve / reject ---------- */

    // Re-reads storage so a request already handled elsewhere is never overwritten.
    function resolveRequest(id, decision, note) {
        var list = A.readSavedList(A.KEYS.requests, []);
        var target = null;
        list.forEach(function (request) {
            if (String(request.id) === String(id)) target = request;
        });
        if (!target || target.status !== 'pending') return null;

        var now = Date.now();
        var approved = decision === 'approved';
        var name = A.studentOf(target);

        target.status = decision;
        target.resolvedAt = now;
        target.resolvedBy = 'Dr. Admin';
        target.reviewNote = note;
        // "detail" is what the student sees under "View details" on their Correction requests page.
        target.detail = approved
            ? 'Approved ' + longDate(now) + ' · Your attendance record was updated to ' + target.requestedStatus + '.' + (note ? ' Note: ' + note : '')
            : 'Reviewed ' + longDate(now) + ' · The instructor could not confirm attendance for this session. Note: ' + note;
        A.saveList(A.KEYS.requests, list);

        // The admin alerts that were raised for this request are now handled.
        var adminAlerts = A.readSavedList(A.KEYS.adminAlerts, []);
        adminAlerts.forEach(function (alert) {
            if (alert.refId === 'req-' + id || alert.refId === 'sla-' + id) alert.unread = false;
        });
        A.saveList(A.KEYS.adminAlerts, adminAlerts);

        // Student inbox: the demo student portal only has one inbox (Ahmed Mohamed).
        var delivered = false;
        if (name === A.STUDENT_NAME) {
            var classDay = longDate(new Date(target.date + 'T12:00:00').getTime());
            A.pushStudentAlert({
                type: approved ? 'approved' : 'absent',
                title: approved ? 'Correction request approved' : 'Correction request rejected',
                message: approved
                    ? 'Your attendance correction for ' + target.course + ' on ' + classDay + ' was approved. Your record now shows ' + target.requestedStatus + '.'
                    : 'Your attendance correction for ' + target.course + ' on ' + classDay + ' was not approved. Instructor note: ' + note,
                tag: target.course,
                action: approved ? 'History' : 'Correction request'
            });
            delivered = true;
        }

        A.addLog(approved ? 'success' : 'warn', 'Corrections',
            name + '\u2019s request for ' + target.course + ' ' + (approved ? 'approved' : 'rejected') + (delivered ? ' · student notified' : ''));

        return { request: target, delivered: delivered, name: name };
    }

    function submitDecision(decision) {
        clearNoteError();
        var note = noteInput.value.trim();
        if (decision === 'rejected' && note.length < 5) {
            noteInput.closest('.field-control').classList.add('has-error');
            noteInput.closest('.field-control').querySelector('.field-error').textContent = 'Add a short reason for the student (at least 5 characters).';
            noteInput.focus();
            return;
        }

        var result = resolveRequest(openId, decision, note);
        closeReview();
        if (!result) {
            showToast('That request was already resolved.');
            A.notifyChange();
            return;
        }

        var verb = decision === 'approved' ? 'Approved' : 'Rejected';
        showToast(result.delivered
            ? verb + ' ' + result.name + '\u2019s request. The student was notified in their Alerts.'
            : verb + ' ' + result.name + '\u2019s request. This demo only has an inbox for ' + A.STUDENT_NAME + ', so no alert was delivered.');
        A.notifyChange();   // re-renders this page and refreshes the sidebar badges
    }

    byId('approveBtn').addEventListener('click', function () { submitDecision('approved'); });
    byId('rejectBtn').addEventListener('click', function () { submitDecision('rejected'); });

    /* ---------- filters, search, row actions ---------- */

    document.querySelectorAll('[data-corr-filter]').forEach(function (tab) {
        tab.addEventListener('click', function () {
            activeFilter = tab.getAttribute('data-corr-filter');
            render();
        });
    });

    byId('requestSearch').addEventListener('input', function (event) {
        searchText = event.target.value.trim().toLowerCase();
        render();
    });

    byId('clearRequestFilters').addEventListener('click', function () {
        activeFilter = 'all';
        searchText = '';
        byId('requestSearch').value = '';
        render();
    });

    byId('requestRows').addEventListener('click', function (event) {
        var button = event.target.closest('[data-review]');
        if (button) openReview(button.getAttribute('data-review'));
    });

    /* ---------- start ---------- */

    var query = new URLSearchParams(window.location.search);
    var filterParam = query.get('filter');
    if (['all', 'urgent', 'pending', 'resolved'].indexOf(filterParam) !== -1) activeFilter = filterParam;

    A.init();
    A.onChange(render);
    render();

    var idParam = query.get('id');
    if (idParam) openReview(idParam);   // used by the dashboard's SLA watchlist links
}());
</file>

<file path="AdminDash.js">
// CampusLens admin dashboard overview. Needs AdminShared.js loaded first.
(function () {
    'use strict';

    var A = window.CampusLensAdmin;
    if (!A) return;

    var escapeHTML = A.escapeHTML;
    var toastTimer = null;

    function byId(id) { return document.getElementById(id); }

    function showToast(message) {
        var toast = byId('adminToast');
        toast.textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 3200);
    }

    /* ---------- summary cards ---------- */

    function renderStats() {
        var now = Date.now();
        var day = A.getDayStats(new Date());
        var pending = A.getPendingStats(now);
        var health = A.getHealth(now);

        byId('statClasses').textContent = String(day.total);
        byId('statClassesFoot').textContent = day.active.length + ' in session now · ' + day.completed + ' completed';

        var rateValue = byId('statRate');
        var rateTrack = byId('statRateTrack');
        var rateFoot = byId('statRateFoot');
        if (day.enrolled === 0) {
            rateValue.textContent = '—';
            rateTrack.style.width = '0%';
            rateFoot.textContent = 'No classes have started yet';
        } else {
            var rate = Math.round((day.present / day.enrolled) * 100);
            rateValue.innerHTML = rate + '<span class="value-percent">%</span>';
            rateTrack.style.width = rate + '%';
            rateFoot.textContent = rate >= 85 ? 'Above the 85% requirement' : 'Below the 85% requirement';
        }

        byId('statPending').textContent = String(pending.count).padStart(2, '0');
        byId('statPendingCard').classList.toggle('alert-card', pending.breached > 0);
        var pendingFoot = byId('statPendingFoot');
        if (pending.breached > 0) {
            pendingFoot.innerHTML = '<span class="sla-pill breached">' + pending.breached + ' SLA breached</span>' +
                (pending.warning > 0 ? '<span>' + pending.warning + ' at risk</span>' : '');
        } else if (pending.warning > 0) {
            pendingFoot.innerHTML = '<span class="sla-pill warning">' + pending.warning + ' nearing SLA</span>';
        } else {
            pendingFoot.innerHTML = '<span class="tiny-dot green"></span>All within the ' + A.SLA_HOURS + '-hour SLA';
        }

        byId('statHealth').innerHTML = '<span class="health-dot state-' + escapeHTML(health.state) + '"></span>' + escapeHTML(health.label);
        var healthFoot = byId('statHealthFoot');
        healthFoot.textContent = health.online + '/' + health.total + ' cameras online · ' + health.latency + ' ms';
        healthFoot.title = health.offlineRooms.length ? 'Offline: ' + health.offlineRooms.join(', ') : 'All cameras online';

        var urgent = pending.breached + pending.warning;
        var badge = byId('urgentBadge');
        badge.textContent = String(urgent);
        badge.hidden = urgent === 0;

        byId('liveSyncLabel').textContent = 'Live · updated ' + new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    /* ---------- active classes right now ---------- */

    function renderActiveClasses() {
        var date = new Date();
        var day = A.getDayStats(date);
        var rowsElement = byId('activeRows');
        var emptyElement = byId('activeEmpty');

        rowsElement.innerHTML = day.active.map(function (course) {
            var present = A.presentCount(course, date);
            var percent = Math.round((present / course.enrolled) * 100);
            var minutesLeft = Math.max(0, Math.round(A.toMinutes(course.end) - A.minutesNow(date)));
            return '<tr>' +
                '<td class="course-cell"><strong><span class="code-chip">' + escapeHTML(course.code) + '</span>' + escapeHTML(course.name) + '</strong><small>' + escapeHTML(course.instructor) + '</small></td>' +
                '<td>' + escapeHTML(course.room) + '</td>' +
                '<td class="time-cell">' + escapeHTML(A.formatClock(course.start)) + ' – ' + escapeHTML(A.formatClock(course.end)) + '<small class="cell-note">Ends in ' + minutesLeft + ' min</small></td>' +
                '<td><div class="attend-cell"><strong class="time-cell">' + present + ' / ' + course.enrolled + '</strong>' +
                '<span class="mini-track' + (percent < 85 ? ' low' : '') + '"><span style="width:' + percent + '%"></span></span><small>' + percent + '%</small></div></td>' +
                '<td><a class="feed-btn" href="MarkAtt.html?course=' + encodeURIComponent(course.code) + '"><span class="live-pulse"></span>View live feed</a></td>' +
                '</tr>';
        }).join('');

        byId('activeCountPill').textContent = day.active.length + ' in session';
        byId('activeTableWrap').hidden = day.active.length === 0;
        emptyElement.hidden = day.active.length > 0;

        if (day.active.length === 0) {
            var next = day.upcoming[0];
            byId('activeEmptyText').textContent = next
                ? 'Next up: ' + next.name + ' (' + next.code + ') starts at ' + A.formatClock(next.start) + ' in ' + next.room + '.'
                : 'All of today\u2019s classes have finished.';
        }
    }

    /* ---------- SLA watchlist and system activity ---------- */

    function renderSlaWatch() {
        var pending = A.getPendingStats(Date.now());
        var list = byId('slaList');
        var empty = byId('slaEmpty');

        list.innerHTML = pending.items.slice(0, 4).map(function (item) {
            var request = item.request;
            var name = A.studentOf(request);
            var label = item.sla.state === 'breached'
                ? 'Breached ' + A.formatDuration(item.sla.remaining) + ' ago'
                : A.formatDuration(item.sla.remaining) + ' left';
            return '<li><a class="sla-item" href="AdminCorr.html?id=' + encodeURIComponent(request.id) + '">' +
                '<span class="sla-avatar">' + escapeHTML(A.initialsOf(name)) + '</span>' +
                '<span class="sla-copy"><strong>' + escapeHTML(name) + '</strong><small>' + escapeHTML(request.course) + ' · ' + escapeHTML(A.formatShortDate(request.date)) + ' → ' + escapeHTML(request.requestedStatus) + '</small></span>' +
                '<span class="sla-pill ' + escapeHTML(item.sla.state) + '">' + escapeHTML(label) + '</span></a></li>';
        }).join('');

        empty.hidden = pending.count > 0;
        byId('slaCountPill').textContent = pending.count + ' pending';
    }

    function renderActivity() {
        byId('activityList').innerHTML = A.getLogs().slice(0, 6).map(function (log) {
            return '<li class="activity-item"><span class="activity-dot level-' + escapeHTML(log.level) + '"></span>' +
                '<span class="activity-copy"><strong>' + escapeHTML(log.message) + '</strong><small>' + escapeHTML(log.source) + ' · ' + escapeHTML(A.timeAgo(log.time)) + '</small></span></li>';
        }).join('');
    }

    function renderAll() {
        renderStats();
        renderActiveClasses();
        renderSlaWatch();
        renderActivity();
    }

    /* ---------- quick action: export CSV ---------- */

    function csvCell(value) {
        var text = String(value == null ? '' : value);
        if (/^[=+\-@\t\r]/.test(text)) text = "'" + text;   // stop spreadsheet formula injection
        return '"' + text.replace(/"/g, '""') + '"';
    }

    function exportCsv() {
        var date = new Date();
        var header = ['Date', 'Course Code', 'Course', 'Room', 'Instructor', 'Start', 'End', 'Status', 'Enrolled', 'Present', 'Attendance %'];
        var rows = A.getCourses().map(function (course) {
            var state = A.sessionState(course, date);
            var present = A.presentCount(course, date);
            return [A.localDateValue(), course.code, course.name, course.room, course.instructor, course.start, course.end, state,
                course.enrolled, present, state === 'upcoming' ? '' : Math.round((present / course.enrolled) * 1000) / 10];
        });
        var csv = '\ufeff' + [header].concat(rows).map(function (row) { return row.map(csvCell).join(','); }).join('\r\n');
        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = 'campuslens-attendance-' + A.localDateValue() + '.csv';
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);

        A.addLog('info', 'Reports', 'Daily attendance CSV exported (' + rows.length + ' sessions)');
        renderActivity();
        showToast('Attendance CSV downloaded (' + rows.length + ' sessions).');
    }

    /* ---------- quick action: broadcast announcement ---------- */

    var dialog = byId('broadcastDialog');
    var form = byId('broadcastForm');
    var titleInput = byId('announceTitle');
    var messageInput = byId('announceMessage');
    var priorityInput = byId('announcePriority');

    function clearBroadcastErrors() {
        [titleInput, messageInput].forEach(function (input) {
            input.closest('.field-control').classList.remove('has-error');
            input.closest('.field-control').querySelector('.field-error').textContent = '';
        });
    }

    function setBroadcastError(input, message) {
        input.closest('.field-control').classList.add('has-error');
        input.closest('.field-control').querySelector('.field-error').textContent = message;
    }

    function openBroadcast() {
        form.reset();
        byId('announceCount').textContent = '0';
        clearBroadcastErrors();
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
        titleInput.focus();
    }

    function closeBroadcast() {
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
    }

    byId('actionBroadcast').addEventListener('click', openBroadcast);
    byId('actionExport').addEventListener('click', exportCsv);
    document.querySelectorAll('[data-close-dialog]').forEach(function (button) {
        button.addEventListener('click', closeBroadcast);
    });

    // Clicking the dim backdrop closes the dialog.
    dialog.addEventListener('click', function (event) {
        if (event.target === dialog) closeBroadcast();
    });

    messageInput.addEventListener('input', function () {
        byId('announceCount').textContent = String(messageInput.value.length);
        messageInput.closest('.field-control').classList.remove('has-error');
    });
    titleInput.addEventListener('input', function () {
        titleInput.closest('.field-control').classList.remove('has-error');
    });

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        clearBroadcastErrors();
        var title = titleInput.value.trim();
        var message = messageInput.value.trim();
        var hasError = false;

        if (title.length < 3) {
            setBroadcastError(titleInput, 'Add a short title (at least 3 characters).');
            hasError = true;
        }
        if (message.length < 10) {
            setBroadcastError(messageInput, 'Write a little more detail (at least 10 characters).');
            hasError = true;
        }
        if (hasError) {
            var firstInvalid = form.querySelector('.has-error input, .has-error textarea');
            if (firstInvalid) firstInvalid.focus();
            return;
        }

        A.publishAnnouncement({ title: title, message: message, priority: priorityInput.value });
        closeBroadcast();
        renderActivity();
        showToast('Announcement sent. Students will see it in their Alerts.');
    });

    /* ---------- start ---------- */

    A.init();
    A.onChange(renderAll);
    renderAll();
}());
</file>

<file path="AdminPages.css">
/* CampusLens admin pages. Load AFTER style.css and CampusPages.css:
   it reuses the sidebar, topbar, cards, tables and forms from CampusPages.css
   and only adds what the admin portal needs on top. */

.admin-page [hidden] { display: none !important; }

/* Sidebar badges */
.nav-count.danger { background: #C0707C; }

/* Summary cards (built on .summary-card from CampusPages.css) */
.summary-card.alert-card { border-color: #F0CDD3; background: linear-gradient(180deg, #FFF8F9, #fff); box-shadow: 0 6px 22px #bc5e6a1c; }
.summary-card.alert-card .summary-value { color: #A9505E; }
.summary-foot { flex-wrap: wrap; }
.sla-pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 99px; font-size: 12px; font-weight: 700; white-space: nowrap; }
.sla-pill::before { width: 5px; height: 5px; border-radius: 50%; background: currentColor; content: ''; }
.sla-pill.breached { color: #B85D6B; background: #FBEDEF; }
.sla-pill.warning { color: #A97422; background: #FBF3E4; }
.sla-pill.ok { color: #2A8468; background: #EAF6F1; }
.health-value { display: flex; align-items: center; gap: 10px; padding-top: 5px; font-size: 24px; letter-spacing: -.5px; }
.health-dot { width: 11px; height: 11px; flex: 0 0 auto; border-radius: 50%; }
.health-dot.state-operational { background: #4BAF8D; box-shadow: 0 0 0 4px #4baf8d26; }
.health-dot.state-degraded { background: #D7A445; box-shadow: 0 0 0 4px #d7a44530; }
.health-dot.state-outage { background: #D27A87; box-shadow: 0 0 0 4px #d27a8730; }

/* Quick actions */
.section-label { margin: 4px 2px 11px; color: #8B90A9; font-size: 11px; font-weight: 800; letter-spacing: 1.35px; }
.quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; margin-bottom: 20px; }
.quick-card { position: relative; display: flex; width: 100%; align-items: center; gap: 14px; padding: 17px 18px; border: 1px solid #E9ECF5; border-radius: 15px; color: inherit; background: #fff; box-shadow: 0 6px 22px #272d6410; text-align: left; text-decoration: none; cursor: pointer; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.quick-card:hover { transform: translateY(-2px); border-color: #D8D0F0; box-shadow: 0 10px 26px #272d6418; }
.quick-icon { display: grid; width: 42px; height: 42px; flex: 0 0 auto; place-items: center; border-radius: 11px; color: #66599C; background: #F2EFFB; }
.quick-icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.quick-card.urgent .quick-icon { color: #B85D6B; background: #FBEDEF; }
.quick-card.export .quick-icon { color: #2A8468; background: #EAF6F1; }
.quick-copy { min-width: 0; flex: 1; }
.quick-copy strong { display: block; color: #30344F; font-size: 15px; font-weight: 800; }
.quick-copy span { display: block; margin-top: 4px; color: #8388A0; font-size: 13px; line-height: 1.5; }
.quick-badge { display: grid; min-width: 22px; height: 22px; place-items: center; padding: 0 6px; border-radius: 99px; color: #fff; background: #C0707C; font-family: 'JetBrains Mono', monospace; font-size: 12px; }

/* Active classes table */
.code-chip { display: inline-block; margin-right: 8px; padding: 3px 7px; border-radius: 6px; color: #4B3B8F; background: #F2F0F8; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 500; }
.cell-note { display: block; margin-top: 4px; color: #A0A4B5; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; }
.attend-cell { display: flex; align-items: center; gap: 10px; }
.attend-cell small { color: #8B90A7; font-size: 12px; font-weight: 600; }
.attend-cell .time-cell { color: #323650 !important; font-weight: 500; }
.mini-track { overflow: hidden; width: 90px; height: 5px; border-radius: 5px; background: #EEF0F8; }
.mini-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7484CC, #A493D5); }
.mini-track.low span { background: linear-gradient(90deg, #D7A445, #E5BE6B); }
.feed-btn { display: inline-flex; min-height: 38px; align-items: center; gap: 8px; padding: 0 12px; border: 1px solid #E1DDF0; border-radius: 8px; color: #474276 !important; background: #fff; font-size: 13px; font-weight: 700; text-decoration: none; transition: border-color .16s, background .16s; }
.feed-btn:hover { border-color: #CAC2E4; background: #FAF8FF; }
.live-pulse { width: 7px; height: 7px; border-radius: 50%; background: #D27A87; box-shadow: 0 0 0 0 #d27a8766; animation: livePulse 1.8s ease-out infinite; }
@keyframes livePulse { 70% { box-shadow: 0 0 0 7px #d27a8700; } 100% { box-shadow: 0 0 0 0 #d27a8700; } }
@media (prefers-reduced-motion: reduce) { .live-pulse { animation: none; } }

/* SLA watchlist + system activity */
.dash-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16px; margin-top: 17px; }
.dash-split .panel { overflow: hidden; }
.plain-list { margin: 0; padding: 0; list-style: none; }
.sla-item { display: flex; align-items: center; gap: 12px; padding: 14px 21px; border-top: 1px solid #F0F1F6; text-decoration: none; transition: background .16s; }
.sla-item:hover { background: #F8F7FD; }
.sla-avatar { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: #3D3C77; background: linear-gradient(140deg, #D5DDF9, #EBDCF8); font-size: 12px; font-weight: 800; }
.sla-copy { min-width: 0; flex: 1; }
.sla-copy strong, .activity-copy strong { display: block; overflow: hidden; color: #333751; font-size: 14px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.sla-copy small, .activity-copy small { display: block; margin-top: 3px; overflow: hidden; color: #9297AA; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.activity-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 21px; border-top: 1px solid #F0F1F6; }
.activity-copy { min-width: 0; flex: 1; }
.activity-copy strong { white-space: normal; }
.activity-dot { width: 8px; height: 8px; margin-top: 6px; flex: 0 0 auto; border-radius: 50%; background: #8174C6; }
.activity-dot.level-success { background: #4BAF8D; }
.activity-dot.level-warn { background: #D7A445; }
.activity-dot.level-error { background: #D27A87; }

/* Broadcast dialog */
.admin-dialog { width: min(480px, calc(100vw - 32px)); padding: 0; border: 1px solid #E5E1F2; border-radius: 17px; color: var(--cp-ink); background: #fff; box-shadow: 0 24px 60px #2a2e6340; font-family: 'Plus Jakarta Sans', sans-serif; }
.admin-dialog::backdrop { background: #2a2e6373; backdrop-filter: blur(3px); }
.admin-dialog form { display: grid; gap: 15px; padding: 0 21px 21px; }
.dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 20px 21px 16px; }
.dialog-head h2 { margin: 0; color: #1D213C; font-size: 20px; font-weight: 800; letter-spacing: -.25px; }
.dialog-head p { margin: 5px 0 0; color: #9297AA; font-size: 14px; line-height: 1.5; }
.dialog-close { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border: 1px solid #E7E9F1; border-radius: 9px; color: #6A6F8E; background: #fff; cursor: pointer; }
.dialog-close:hover { background: #F8F7FD; }
.dialog-close svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 3px; }
.admin-dialog .field-control select { padding-right: 18px; }
.admin-dialog .field-control textarea { height: 96px; }

/* Toast */
.admin-toast { position: fixed; right: 24px; bottom: 24px; z-index: 30; max-width: min(380px, calc(100vw - 32px)); padding: 13px 16px; border-radius: 12px; color: #fff; background: #2A2E63; box-shadow: 0 12px 30px #2a2e6342; font-size: 14px; font-weight: 600; line-height: 1.5; opacity: 0; transform: translateY(10px); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }
.admin-toast.show { opacity: 1; transform: translateY(0); }

@media (max-width: 1100px) {
    .quick-grid { gap: 9px; }
    .quick-card { padding: 15px 13px; }
}
@media (max-width: 900px) {
    .quick-grid, .dash-split { grid-template-columns: 1fr; }
}
@media (max-width: 660px) {
    .health-value { font-size: 20px; }
    .sla-item, .activity-item { padding: 13px 15px; }
    .sla-item .sla-pill { display: none; }
    .admin-toast { right: 16px; bottom: 16px; }
    .dialog-actions { flex-direction: column-reverse; }
    .dialog-actions .button { width: 100%; }
}
