.aura {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    --x1: 4%;
    --y1: 4%;
    --x2: 96%;
    --y2: 6%;
    --x3: 4%;
    --y3: 96%;
    --x4: 96%;
    --y4: 94%;
    --x5: 40%;
    --y5: 104%;
    background:
        radial-gradient(70vmax 56vmax at var(--x1) var(--y1), rgba(168, 183, 240, 0.70) 0%, rgba(168, 183, 240, 0.42) 28%, rgba(168, 183, 240, 0.17) 58%, rgba(168, 183, 240, 0.04) 82%, rgba(168, 183, 240, 0) 100%),
        radial-gradient(74vmax 58vmax at var(--x2) var(--y2), rgba(205, 188, 246, 0.68) 0%, rgba(205, 188, 246, 0.40) 28%, rgba(205, 188, 246, 0.16) 58%, rgba(205, 188, 246, 0.04) 82%, rgba(205, 188, 246, 0) 100%),
        radial-gradient(70vmax 56vmax at var(--x3) var(--y3), rgba(199, 217, 247, 0.80) 0%, rgba(199, 217, 247, 0.48) 28%, rgba(199, 217, 247, 0.20) 58%, rgba(199, 217, 247, 0.05) 82%, rgba(199, 217, 247, 0) 100%),
        radial-gradient(72vmax 56vmax at var(--x4) var(--y4), rgba(224, 214, 248, 0.85) 0%, rgba(224, 214, 248, 0.50) 28%, rgba(224, 214, 248, 0.20) 58%, rgba(224, 214, 248, 0.05) 82%, rgba(224, 214, 248, 0) 100%),
        radial-gradient(60vmax 46vmax at var(--x5) var(--y5), rgba(168, 183, 240, 0.55) 0%, rgba(168, 183, 240, 0.32) 28%, rgba(168, 183, 240, 0.13) 58%, rgba(168, 183, 240, 0.03) 82%, rgba(168, 183, 240, 0) 100%),
        var(--background);
    animation:
        m1 28s ease-in-out infinite alternate,
        m2 34s ease-in-out infinite alternate,
        m3 31s ease-in-out infinite alternate,
        m4 37s ease-in-out infinite alternate,
        m5 25s ease-in-out infinite alternate;
}

@keyframes m1 {
    from {
        --x1: 0%;
        --y1: 0%;
    }

    to {
        --x1: 30%;
        --y1: 36%;
    }
}

@keyframes m2 {
    from {
        --x2: 100%;
        --y2: 0%;
    }

    to {
        --x2: 70%;
        --y2: 40%;
    }
}

@keyframes m3 {
    from {
        --x3: 0%;
        --y3: 100%;
    }

    to {
        --x3: 32%;
        --y3: 66%;
    }
}

@keyframes m4 {
    from {
        --x4: 100%;
        --y4: 100%;
    }

    to {
        --x4: 68%;
        --y4: 62%;
    }
}

@keyframes m5 {
    from {
        --x5: 30%;
        --y5: 106%;
    }

    to {
        --x5: 70%;
        --y5: 84%;
    }
}

