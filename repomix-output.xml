.chart-svg .axis { fill: #9297AB; font: 500 11px 'JetBrains Mono', monospace; }
.chart-svg .val { fill: #555B77; font: 600 11px 'JetBrains Mono', monospace; text-anchor: middle; }
.chart-svg .target { stroke: #D7A445; stroke-width: 1.2; stroke-dasharray: 5 4; }
