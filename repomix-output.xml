                        <div class="empty-state" id="sentEmpty" hidden><span class="empty-icon">▤</span><h3>Nothing sent yet</h3><p>Broadcasts you send will be listed here.</p></div>
                    </section>
                </div>

                <section class="panel records-panel" aria-labelledby="inboxHeading">
                    <div class="panel-heading">
