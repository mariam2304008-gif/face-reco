                <span>Campus<span class="brand-light">Lens</span><small>ADMIN PORTAL</small></span>
            </a>
            <div class="side-caption">MANAGEMENT</div>
            <nav class="side-nav" aria-label="Main navigation">
                <a href="AdminDash.html" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>Dashboard overview</span></a>
                <a href="MarkAtt.html" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/></svg><span>Live attendance</span></a>
                <a href="AdminCorr.html" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 4 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z"/><path d="M12 20h8"/></svg><span>Correction requests</span><span class="nav-count" data-pending-count>0</span></a>
                <a href="UserMang.html" class="nav-link active" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg><span>Students &amp; users</span></a>
                <a href="Analytics.html" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="M8 16v-5M13 16V7M18 16v-8"/></svg><span>Analytics</span></a>
                <a href="MangAlerts.html" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 18-5v12L3 13v-2Z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg><span>Alerts &amp; announcements</span><span class="nav-count" data-unread-count>0</span></a>
            </nav>
            <div class="sidebar-bottom">
                <div class="term-card"><span class="term-icon">✦</span><div><strong>Fall semester</strong><span>2026 — 2027</span></div></div>
                <div class="student-mini"><span class="avatar">DA</span><span><strong>Dr. Admin</strong><small>System administrator</small></span><span class="online-dot" aria-label="Online"></span></div>
            </div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div class="crumb"><span>Admin</span><span class="crumb-slash">/</span><strong>Students &amp; users</strong></div>
                <div class="top-actions">
                    <span class="today-label" id="todayLabel">SUNDAY, OCTOBER 18</span>
                    <a class="top-alert" href="MangAlerts.html" aria-label="Open alerts and announcements"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><i></i></a>
                    <span class="avatar top-avatar" title="Dr. Admin">DA</span>
                </div>
            </header>

            <div class="page-content">
                <section class="page-heading">
                    <div>
                        <div class="eyebrow"><span class="eyebrow-dot"></span>ENROLLMENT AND FACE DATA</div>
                        <h1>Students &amp; face recognition</h1>
                        <p class="page-lede">Oversee student enrollments and the face-embedding database.</p>
                    </div>
                    <div class="um-bulk">
                        <button class="button button-soft" id="openImport" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m0 0L8 7m4-4 4 4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>Import students</button>
                        <button class="button button-primary" id="exportRoster" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>Export roster</button>
                    </div>
                </section>

                <section class="summary-grid" aria-label="Enrollment summary">
                    <article class="summary-card">
                        <div class="summary-top"><span>Registered students</span><span class="summary-icon icon-blue">▤</span></div>
                        <div class="summary-value" id="umTotal">0</div>
                        <div class="summary-foot"><span class="tiny-dot blue"></span>In the roster</div>
                    </article>
                    <article class="summary-card rate-card">
                        <div class="summary-top"><span>Face data enrolled</span><span class="summary-icon icon-green">✓</span></div>
                        <div class="summary-value" id="umEnrolled">0</div>
                        <div class="rate-track"><span id="umRateTrack" style="width:0%"></span></div>
                        <div class="summary-foot" id="umRateFoot">—</div>
                    </article>
                    <article class="summary-card">
                        <div class="summary-top"><span>Pending enrollment</span><span class="summary-icon icon-amber">◷</span></div>
                        <div class="summary-value" id="umPending">00</div>
                        <div class="summary-foot"><span class="tiny-dot amber"></span>No face data yet</div>
                    </article>
                    <article class="summary-card">
                        <div class="summary-top"><span>Suspended accounts</span><span class="summary-icon icon-rose">–</span></div>
                        <div class="summary-value" id="umSuspended">00</div>
                        <div class="summary-foot"><span class="tiny-dot rose"></span>Access disabled</div>
                    </article>
                </section>

                <section class="db-strip" aria-label="Face embedding database">
                    <span class="db-title"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>Face-embedding database</span>
                    <span class="db-item"><strong id="dbEmbeddings">0</strong> embeddings across <strong id="dbStudents">0</strong> students</span>
                    <span class="db-item">Model <strong>v2.4</strong></span>
                    <span class="db-item">Last indexed <strong id="dbIndexed">Never</strong></span>
                    <span class="footer-note"><span class="tiny-dot green"></span><span id="liveSyncLabel">Live</span></span>
                </section>

                <section class="panel records-panel" aria-labelledby="studentsHeading">
                    <div class="panel-heading">
                        <div><h2 id="studentsHeading">Student roster</h2><p>Search, filter and manage face data for each student</p></div>
                    </div>
                    <div class="um-toolbar">
                        <div class="filter-tabs" role="group" aria-label="Filter by status">
                            <button type="button" class="filter-tab active" data-um-filter="all" aria-pressed="true">All <span data-count="all">0</span></button>
                            <button type="button" class="filter-tab" data-um-filter="enrolled" aria-pressed="false">Enrolled <span data-count="enrolled">0</span></button>
                            <button type="button" class="filter-tab" data-um-filter="pending" aria-pressed="false">Pending <span data-count="pending">0</span></button>
                            <button type="button" class="filter-tab" data-um-filter="suspended" aria-pressed="false">Suspended <span data-count="suspended">0</span></button>
                        </div>
                        <div class="um-filters">
                            <label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg><input id="studentSearch" type="search" placeholder="Search name, ID, email or department..." aria-label="Search students"></label>
                            <label class="select-wrap"><span class="sr-only">Filter by department</span><select id="deptFilter"><option value="all">All departments</option></select><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></label>
                            <label class="select-wrap"><span class="sr-only">Sort students</span><select id="sortSelect"><option value="name">Sort: Name</option><option value="active">Sort: Last active</option><option value="pending">Sort: Pending first</option></select><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></label>
                            <button class="text-button clear-filters" id="clearStudentFilters" type="button">Clear</button>
                        </div>
                    </div>
                    <div class="table-wrap" id="studentsTableWrap">
                        <table class="records-table um-table">
                            <thead><tr><th>STUDENT</th><th>ID</th><th>DEPARTMENT</th><th>FACE DATA</th><th>LAST ACTIVE</th><th aria-label="Actions"></th></tr></thead>
                            <tbody id="studentRows"></tbody>
                        </table>
                    </div>
                    <div class="empty-state" id="studentsEmpty" hidden><span class="empty-icon">⌕</span><h3>No students found</h3><p>Try another search or clear your filters.</p><button class="button button-soft" type="button" id="emptyClearFilters">Clear filters</button></div>
                    <div class="um-more" id="loadMoreWrap" hidden><button class="button button-soft" id="loadMore" type="button">Show more students</button></div>
                    <div class="table-footer"><span id="studentsFooter">Showing 0 of 0 students</span><span class="footer-note"><span class="tiny-dot green"></span>Saved in this browser</span></div>
                </section>

                <p class="demo-note"><span>ⓘ</span> Demo roster stored in this browser. Face scans, onboarding links and imports are simulated; a real deployment needs a university backend and a face-embedding service.</p>
            </div>
        </main>
    </div>

    <dialog class="admin-dialog um-dialog" id="historyDialog" aria-labelledby="historyHeading">
        <div class="dialog-head">
            <div><span class="section-kicker">ATTENDANCE HISTORY</span><h2 id="historyHeading">Student</h2><p id="historySub"></p></div>
            <button class="dialog-close" type="button" data-close-dialog aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <div class="um-body">
            <div class="um-chips" id="historyChips"></div>
            <div class="table-wrap" id="historyTableWrap">
                <table class="records-table">
                    <thead><tr><th>DATE</th><th>COURSE</th><th>CHECK-IN</th><th>CHECK-OUT</th><th>STATUS</th></tr></thead>
                    <tbody id="historyRows"></tbody>
                </table>
            </div>
            <div class="empty-state" id="historyEmpty" hidden><span class="empty-icon">◷</span><h3>No attendance recorded</h3><p>Attendance is recorded by face scan, so it starts once this student has enrolled face data.</p></div>
            <div class="dialog-actions"><button class="button button-soft" type="button" data-close-dialog>Close</button></div>
        </div>
    </dialog>

    <dialog class="admin-dialog um-dialog narrow" id="scanDialog" aria-labelledby="scanHeading">
        <div class="dialog-head">
            <div><span class="section-kicker">FACE ENROLLMENT</span><h2 id="scanHeading">Student</h2><p id="scanSub"></p></div>
            <button class="dialog-close" type="button" data-close-dialog aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <div class="um-body">
            <div class="um-callout" id="scanNote"></div>
            <ol class="scan-steps" id="scanSteps">
                <li><span class="scan-dot"></span><span>Remove the current face embedding</span></li>
                <li><span class="scan-dot"></span><span>Send the onboarding link to the student</span></li>
                <li><span class="scan-dot"></span><span>Wait for the student to capture a new face scan</span></li>
            </ol>
            <div class="dialog-actions">
                <button class="button button-soft" type="button" data-close-dialog>Close</button>
                <button class="button button-primary" type="button" id="scanPrimary">Send re-scan request</button>
            </div>
        </div>
    </dialog>

    <dialog class="admin-dialog um-dialog narrow" id="suspendDialog" aria-labelledby="suspendHeading">
        <div class="dialog-head">
            <div><span class="section-kicker">ACCOUNT ACCESS</span><h2 id="suspendHeading">Suspend account?</h2><p id="suspendText"></p></div>
            <button class="dialog-close" type="button" data-close-dialog aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <div class="um-body">
            <label class="field-group" for="suspendReason"><span>Reason (optional)</span><span class="field-control textarea-control"><textarea id="suspendReason" maxlength="160" rows="3" placeholder="e.g. Withdrawn from the semester"></textarea><span class="char-count"><span id="suspendCount">0</span>/160</span></span></label>
            <div class="dialog-actions">
                <button class="button button-soft" type="button" data-close-dialog>Cancel</button>
                <button class="button button-danger" type="button" id="suspendConfirm">Suspend account</button>
            </div>
        </div>
    </dialog>

    <dialog class="admin-dialog um-dialog" id="importDialog" aria-labelledby="importHeading">
        <div class="dialog-head">
            <div><span class="section-kicker">BULK IMPORT</span><h2 id="importHeading">Import students</h2><p>Upload or paste a JSON or CSV list. Nothing is saved until you confirm.</p></div>
            <button class="dialog-close" type="button" data-close-dialog aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <div class="um-body">
            <label class="field-group" for="importFile"><span>Choose a file (.json or .csv, up to 1 MB)</span><span class="field-control um-file"><input id="importFile" type="file" accept=".json,.csv,application/json,text/csv"></span></label>
            <label class="field-group" for="importText"><span>Or paste data</span><span class="field-control textarea-control"><textarea id="importText" spellcheck="false" placeholder='CSV: name,id,department,email&#10;JSON: [{"name":"...","id":"20231234","department":"..."}]'></textarea></span></label>
            <div class="um-import-tools">
                <button class="button button-soft" type="button" id="importPreview">Preview import</button>
                <button class="text-button" type="button" id="importSample">Load sample data</button>
            </div>
            <div class="um-result" id="importResult" hidden></div>
            <div class="dialog-actions">
                <button class="button button-soft" type="button" data-close-dialog>Cancel</button>
                <button class="button button-primary" type="button" id="importConfirm" disabled>Import students</button>
            </div>
        </div>
    </dialog>

    <div class="admin-toast" id="adminToast" role="status" aria-live="polite"></div>

    <script src="AdminShared.js" defer></script>
    <script src="UserMang.js" defer></script>
</body>
</html>
